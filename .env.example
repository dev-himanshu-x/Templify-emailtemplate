# Optional: preconfigured sender accounts for the Send dialog (JSON array, one object per account).
# You can also just type your account into the Send dialog and skip this file.
# For Gmail, create an app password: https://myaccount.google.com/apppasswords
# Optional per account: "host" (default smtp.gmail.com), "port" (default 465), "secure".
# Copy this file to .env.local and fill it in. Never commit real passwords.
MAIL_ACCOUNTS=[{"name":"Acme Team","email":"you@gmail.com","pass":"your-app-password"}]

# Sending is blocked in production builds unless you opt in. Only enable it on a server you trust.
# ALLOW_SEND=true
